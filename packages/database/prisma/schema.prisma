generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────
// ENUMS
// ────────────────────────────────────────────────
enum PerfilUsuario {
  aluno
  professor
  admin

  @@map("perfil_usuario")
}

enum StatusUsuario {
  ativo
  inativo
  banido
  pendente

  @@map("status_usuario")
}

enum StatusAssinatura {
  ativa
  cancelada
  expirada
  trial

  @@map("status_assinatura")
}

enum VisibilidadePerfil {
  privado
  basico_publico
  completo_publico

  @@map("visibilidade_perfil")
}

enum StatusPedido {
  pendente
  processando
  entregue
  cancelado

  @@map("status_pedido")
}

enum StatusConcurso {
  aberto
  previsto
  encerrado

  @@map("status_concurso")
}

enum AcessoQuestao {
  free
  premium

  @@map("acesso_questao")
}

enum VisibilidadeQuestao {
  publica
  privada
  restrita

  @@map("visibilidade_questao")
}

enum StatusQuestao {
  draft
  published
  archived
  reported

  @@map("status_questao")
}

enum StatusDenuncia {
  pendente
  em_analise
  resolvida
  ignorada

  @@map("status_denuncia")
}

enum MotivoDenuncia {
  gabarito_errado
  enunciado_errado
  alternativa_errada
  questao_desatualizada
  conteudo_inapropriado
  outro

  @@map("motivo_denuncia")
}

enum VisibilidadeCaderno {
  privado
  publico

  @@map("visibilidade_caderno")
}

enum PeriodoRanking {
  semanal
  mensal
  geral

  @@map("periodo_ranking")
}

enum StatusRevisao {
  pendente
  revisada
  adiada

  @@map("status_revisao")
}

enum StatusTicket {
  aberto
  em_atendimento
  aguardando_usuario
  resolvido
  fechado

  @@map("status_ticket")
}

enum PrioridadeTicket {
  baixa
  media
  alta
  urgente

  @@map("prioridade_ticket")
}

enum CategoriaTicket {
  financeiro
  tecnico
  conteudo
  conta
  outro

  @@map("categoria_ticket")
}

enum MetodoPagamento {
  cartao_credito
  cartao_debito
  pix
  boleto

  @@map("metodo_pagamento")
}

enum StatusPagamento {
  pendente
  aprovado
  recusado
  reembolsado
  cancelado
  expirado

  @@map("status_pagamento")
}

enum TipoNotificacao {
  ranking_posicao
  revisao_pendente
  ticket_resposta
  assinatura_vencendo
  assinatura_vencida
  questao_comentario
  conquista
  sistema

  @@map("tipo_notificacao")
}

enum StatusSimulado {
  draft
  published
  archived

  @@map("status_simulado")
}

enum VisibilidadeSimulado {
  privado
  publico

  @@map("visibilidade_simulado")
}

enum StatusTentativa {
  em_andamento
  concluida
  abandonada
  tempo_esgotado

  @@map("status_tentativa")
}

// ────────────────────────────────────────────────
// MODELOS
// ────────────────────────────────────────────────

model Plano {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome        String   @unique @db.VarChar(50)
  duracaoDias Int      @map("duracao_dias")
  preco       Decimal  @db.Decimal(10, 2)
  descricao   String?
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em")

  usuarios    Usuario[]
  assinaturas Assinatura[]
  pedidoItens PedidoItem[]

  @@map("planos")
}

model Usuario {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String        @unique @db.VarChar(255)
  senhaHash        String?       @map("senha_hash")
  nome             String        @db.VarChar(150)
  sobrenome        String?       @db.VarChar(150)
  cpf              String?       @unique @db.VarChar(14)
  telefone         String?       @db.VarChar(20)
  dataNascimento   DateTime?     @map("data_nascimento") @db.Date
  avatarUrl        String?       @map("avatar_url")
  perfil           PerfilUsuario @default(aluno)
  status           StatusUsuario @default(pendente)
  planoId          String?       @map("plano_id") @db.Uuid
  emailVerificado  Boolean       @default(false) @map("email_verificado")
  tokenVerificacao String?       @map("token_verificacao")
  tokenExpiraEm    DateTime?     @map("token_expira_em")
  ultimoAcesso     DateTime?     @map("ultimo_acesso")
  criadoEm         DateTime      @default(now()) @map("criado_em")
  atualizadoEm     DateTime      @default(now()) @updatedAt @map("atualizado_em")

  plano            Plano?               @relation(fields: [planoId], references: [id], onDelete: SetNull)
  sessoes          Sessao[]
  recuperacoes     RecuperacaoSenha[]
  assinaturas      Assinatura[]
  perfilExtra      Perfil?
  seguindo         Seguidor[]           @relation("SeguidorParaUsuario")
  seguidores       Seguidor[]           @relation("UsuarioParaSeguidor")
  enderecos        Endereco[]
  historicoSenhas  HistoricoSenha[]
  pedidos          Pedido[]
  questoesAutor    Questao[]            @relation("QuestaoAutor")
  questoesRevisor  Questao[]            @relation("QuestaoRevisor")
  respostas        RespostaUsuario[]
  favoritos        Favorito[]
  comentarios      Comentario[]
  curtidas         ComentarioCurtida[]
  denuncias        Denuncia[]
  denunciasResolv  Denuncia[]           @relation("DenunciaResolvidaPor")
  cadernos         Caderno[]
  rankings         Ranking[]
  revisoes         Revisao[]
  anotacoes        Anotacao[]
  ticketsCriados   Ticket[]             @relation("TicketUsuario")
  ticketsAtendidos Ticket[]             @relation("TicketAtendente")
  ticketMensagens  TicketMensagem[]
  estatisticas     EstatisticaUsuario[]
  pagamentos       Pagamento[]
  notificacoes     Notificacao[]
  auditLogs        AuditLog[]
  simuladosCriados Simulado[]
  tentativasSimul  SimuladoTentativa[]
  configsAtualiz   Configuracao[]
  accounts         Account[]
  verifications    Verification[]

  @@index([email])
  @@index([status])
  @@index([planoId])
  @@map("usuarios")
}

model Sessao {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  refreshToken String   @unique @map("refresh_token")
  dispositivo  String?  @db.VarChar(255)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  expiraEm     DateTime @map("expira_em")
  criadoEm     DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([refreshToken])
  @@map("sessoes")
}

model RecuperacaoSenha {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  token     String   @unique
  usado     Boolean  @default(false)
  expiraEm  DateTime @map("expira_em")
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("recuperacao_senha")
}

model Assinatura {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId     String           @map("usuario_id") @db.Uuid
  planoId       String           @map("plano_id") @db.Uuid
  status        StatusAssinatura @default(trial)
  inicioEm      DateTime         @default(now()) @map("inicio_em")
  expiraEm      DateTime?        @map("expira_em")
  renovacaoAuto Boolean          @default(true) @map("renovacao_auto")
  criadoEm      DateTime         @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  plano   Plano   @relation(fields: [planoId], references: [id])

  @@index([usuarioId])
  @@map("assinaturas")
}

model Perfil {
  usuarioId    String             @id @map("usuario_id") @db.Uuid
  nomeExibicao String?            @map("nome_exibicao") @db.VarChar(100)
  avatarUrl    String?            @map("avatar_url")
  bio          String?            @db.VarChar(2000)
  telefone     String?            @db.VarChar(20)
  carreiraId   String?            @map("carreira_id") @db.Uuid
  visibilidade VisibilidadePerfil @default(privado)
  instagram    String?            @db.VarChar(100)
  tiktok       String?            @db.VarChar(100)
  facebook     String?            @db.VarChar(100)
  atualizadoEm DateTime           @default(now()) @updatedAt @map("atualizado_em")

  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  carreira Carreira? @relation(fields: [carreiraId], references: [id], onDelete: SetNull)

  @@index([carreiraId])
  @@map("perfis")
}

model Seguidor {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String   @map("usuario_id") @db.Uuid
  seguidorId String   @map("seguidor_id") @db.Uuid
  criadoEm   DateTime @default(now()) @map("criado_em")

  usuario  Usuario @relation("UsuarioParaSeguidor", fields: [usuarioId], references: [id], onDelete: Cascade)
  seguidor Usuario @relation("SeguidorParaUsuario", fields: [seguidorId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, seguidorId])
  @@index([usuarioId])
  @@index([seguidorId])
  @@map("seguidores")
}

model Endereco {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  apelido     String?  @db.VarChar(50)
  cep         String   @db.VarChar(9)
  logradouro  String   @db.VarChar(200)
  numero      String   @db.VarChar(20)
  complemento String?  @db.VarChar(100)
  referencia  String?  @db.VarChar(200)
  bairro      String   @db.VarChar(100)
  cidade      String   @db.VarChar(100)
  estado      String   @db.Char(2)
  principal   Boolean  @default(false)
  criadoEm    DateTime @default(now()) @map("criado_em")

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@index([usuarioId])
  @@map("enderecos")
}

model HistoricoSenha {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  dispositivo String?  @db.VarChar(255)
  criadoEm    DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("historico_senhas")
}

model Pedido {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo          String       @unique @db.VarChar(20)
  usuarioId       String       @map("usuario_id") @db.Uuid
  status          StatusPedido @default(pendente)
  descricao       String
  total           Decimal      @db.Decimal(10, 2)
  quantidadeItens Int          @default(1) @map("quantidade_itens")
  enderecoId      String?      @map("endereco_id") @db.Uuid
  criadoEm        DateTime     @default(now()) @map("criado_em")
  atualizadoEm    DateTime     @default(now()) @updatedAt @map("atualizado_em")

  usuario    Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  endereco   Endereco?    @relation(fields: [enderecoId], references: [id], onDelete: SetNull)
  itens      PedidoItem[]
  pagamentos Pagamento[]

  @@index([usuarioId])
  @@index([status])
  @@index([codigo])
  @@map("pedidos")
}

model PedidoItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId  String   @map("pedido_id") @db.Uuid
  planoId   String   @map("plano_id") @db.Uuid
  descricao String
  preco     Decimal  @db.Decimal(10, 2)
  criadoEm  DateTime @default(now()) @map("criado_em")

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  plano  Plano  @relation(fields: [planoId], references: [id])

  @@index([pedidoId])
  @@map("pedido_itens")
}

model NivelEducacional {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome     String   @unique @db.VarChar(100)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  concursos Concurso[]
  questoes  Questao[]

  @@map("niveis_educacionais")
}

model Dificuldade {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome     String   @unique @db.VarChar(50)
  slug     String   @unique @db.VarChar(50)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  questoes Questao[]

  @@map("dificuldades")
}

model Banca {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String   @unique @db.VarChar(150)
  sigla     String   @unique @db.VarChar(30)
  descricao String?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  concursos Concurso[]
  questoes  Questao[]

  @@map("bancas")
}

model Carreira {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String   @unique @db.VarChar(100)
  descricao String?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  perfis    Perfil[]
  concursos Concurso[]
  questoes  Questao[]
  rankings  Ranking[]
  simulados Simulado[]

  @@map("carreiras")
}

model Concurso {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String         @db.VarChar(255)
  sigla      String?        @db.VarChar(20)
  cargo      String?        @db.VarChar(150)
  bancaId    String?        @map("banca_id") @db.Uuid
  carreiraId String?        @map("carreira_id") @db.Uuid
  nivelId    String?        @map("nivel_id") @db.Uuid
  ano        Int?           @db.SmallInt
  status     StatusConcurso @default(previsto)
  ativo      Boolean        @default(true)
  criadoEm   DateTime       @default(now()) @map("criado_em")

  banca     Banca?            @relation(fields: [bancaId], references: [id], onDelete: SetNull)
  carreira  Carreira?         @relation(fields: [carreiraId], references: [id], onDelete: SetNull)
  nivel     NivelEducacional? @relation(fields: [nivelId], references: [id], onDelete: SetNull)
  questoes  Questao[]
  simulados Simulado[]

  @@map("concursos")
}

model Disciplina {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(20)
  nome      String   @unique @db.VarChar(150)
  descricao String?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  assuntos     Assunto[]
  questoes     Questao[]
  estatisticas EstatisticaUsuario[]

  @@map("disciplinas")
}

model Assunto {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disciplinaId String   @map("disciplina_id") @db.Uuid
  nome         String   @db.VarChar(200)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")

  disciplina Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  topicos    Topico[]
  questoes   Questao[]

  @@unique([disciplinaId, nome])
  @@map("assuntos")
}

model Topico {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assuntoId String   @map("assunto_id") @db.Uuid
  nome      String   @db.VarChar(200)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  assunto    Assunto     @relation(fields: [assuntoId], references: [id], onDelete: Cascade)
  subtopicos Subtopico[]
  questoes   Questao[]

  @@unique([assuntoId, nome])
  @@map("topicos")
}

model Subtopico {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicoId String   @map("topico_id") @db.Uuid
  nome     String   @db.VarChar(200)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  topico   Topico    @relation(fields: [topicoId], references: [id], onDelete: Cascade)
  questoes Questao[]

  @@unique([topicoId, nome])
  @@map("subtopicos")
}

model TipoQuestao {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                  String   @unique @db.VarChar(100)
  slug                  String   @unique @db.VarChar(50)
  modelo                String?  @db.VarChar(20) // certo_errado, multipla_escolha
  quantidadeAlternativas Int?     @default(5) @map("quantidade_alternativas") @db.SmallInt
  ativo                 Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  questoes Questao[]

  @@map("tipos_questao")
}

model Questao {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String              @unique @db.VarChar(20)
  disciplinaId     String?             @map("disciplina_id") @db.Uuid
  assuntoId        String?             @map("assunto_id") @db.Uuid
  topicoId         String?             @map("topico_id") @db.Uuid
  subtopicoId      String?             @map("subtopico_id") @db.Uuid
  bancaId          String?             @map("banca_id") @db.Uuid
  concursoId       String?             @map("concurso_id") @db.Uuid
  carreiraId       String?             @map("carreira_id") @db.Uuid
  nivelId          String?             @map("nivel_id") @db.Uuid
  dificuldadeId    String?             @map("dificuldade_id") @db.Uuid
  tipoId           String?             @map("tipo_id") @db.Uuid
  instituicao      String?             @db.VarChar(150)
  cargo            String?             @db.VarChar(150)
  ano              Int?                @db.SmallInt
  isInedita        Boolean             @default(false) @map("is_inedita")
  enunciado        String
  textoApoio       String?             @map("texto_apoio")
  resolucao        String?
  hasVideo         Boolean             @default(false) @map("has_video")
  acesso           AcessoQuestao       @default(free)
  visibilidade     VisibilidadeQuestao @default(publica)
  status           StatusQuestao       @default(draft)
  autorId          String?             @map("autor_id") @db.Uuid
  revisorId        String?             @map("revisor_id") @db.Uuid
  revisadoEm       DateTime?           @map("revisado_em")
  totalRespostas   Int                 @default(0) @map("total_respostas")
  taxaAcerto       Decimal             @default(0) @map("taxa_acerto") @db.Decimal(5, 2)
  tempoMedioSeg    Int                 @default(0) @map("tempo_medio_seg")
  totalComentarios Int                 @default(0) @map("total_comentarios")
  totalDenuncias   Int                 @default(0) @map("total_denuncias")
  criadoEm         DateTime            @default(now()) @map("criado_em")
  atualizadoEm     DateTime            @default(now()) @updatedAt @map("atualizado_em")

  disciplina  Disciplina?       @relation(fields: [disciplinaId], references: [id], onDelete: SetNull)
  assunto     Assunto?          @relation(fields: [assuntoId], references: [id], onDelete: SetNull)
  topico      Topico?           @relation(fields: [topicoId], references: [id], onDelete: SetNull)
  subtopico   Subtopico?        @relation(fields: [subtopicoId], references: [id], onDelete: SetNull)
  banca       Banca?            @relation(fields: [bancaId], references: [id], onDelete: SetNull)
  concurso    Concurso?         @relation(fields: [concursoId], references: [id], onDelete: SetNull)
  carreira    Carreira?         @relation(fields: [carreiraId], references: [id], onDelete: SetNull)
  nivel       NivelEducacional? @relation(fields: [nivelId], references: [id], onDelete: SetNull)
  dificuldade Dificuldade?      @relation(fields: [dificuldadeId], references: [id], onDelete: SetNull)
  tipo        TipoQuestao?      @relation(fields: [tipoId], references: [id], onDelete: SetNull)
  autor       Usuario?          @relation("QuestaoAutor", fields: [autorId], references: [id], onDelete: SetNull)
  revisor     Usuario?          @relation("QuestaoRevisor", fields: [revisorId], references: [id], onDelete: SetNull)

  alternativas     Alternativa[]
  tags             QuestaoTag[]
  keywords         QuestaoKeyword[]
  objetivos        QuestaoObjetivo[]
  referencias      QuestaoReferencia[]
  videos           QuestaoVideo[]
  respostas        RespostaUsuario[]
  favoritos        Favorito[]
  comentarios      Comentario[]
  denuncias        Denuncia[]
  cadernos         CadernoQuestao[]
  revisoes         Revisao[]
  anotacoes        Anotacao[]
  simuladoQuestoes SimuladoQuestao[]
  simuladoRespos   SimuladoResposta[]

  @@index([disciplinaId])
  @@index([bancaId])
  @@index([status])
  @@index([acesso])
  @@index([dificuldadeId])
  @@index([ano])
  @@map("questoes")
}

model Alternativa {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questaoId  String   @map("questao_id") @db.Uuid
  letra      String   @db.Char(1)
  texto      String
  isCorreta  Boolean  @default(false) @map("is_correta")
  percentual Decimal? @db.Decimal(5, 2)
  explicacao String?
  referencia String?
  dica       String?

  questao           Questao            @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  respostasUsuarios RespostaUsuario[]
  simuladoRespostas SimuladoResposta[]

  @@unique([questaoId, letra])
  @@index([questaoId])
  @@map("alternativas")
}

model QuestaoTag {
  questaoId String @map("questao_id") @db.Uuid
  tag       String @db.VarChar(100)

  questao Questao @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  @@id([questaoId, tag])
  @@map("questao_tags")
}

model QuestaoKeyword {
  questaoId String @map("questao_id") @db.Uuid
  keyword   String @db.VarChar(100)

  questao Questao @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  @@id([questaoId, keyword])
  @@map("questao_keywords")
}

model QuestaoObjetivo {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questaoId String @map("questao_id") @db.Uuid
  descricao String

